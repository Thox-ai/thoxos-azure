{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Deploy a paid Azure Ubuntu 24.04 host running the genuine ThoxInux v0.9.1 open source engineering-preview kernel in a persistent nonroot QEMU TCG guest. Native Ginux Hyper-V boot and a graphical ThoxOS desktop are not qualified by this package. All inbound ports are denied; manage through Azure Run Command. Deployment waits for actual current-boot acceptance.",
    "packageVersion": "v0.1.0",
    "release": "v0.9.1",
    "sourceCommit": "84b4a7e740496297ca79dff735834ca2a8f2bad3",
    "efiSha256": "1bc1c7af33470edc009fa5756d3fe6063573660e07e157d19397afc680a7bb89",
    "bootstrapSha256": "4f0e827609f163883ea615a1875a8780f3b7dcea9e9bbe6af9438aa367eec4fe",
    "bootstrapBytes": 25679,
    "hostImagePolicy": "Regional latest by default; exact imageReference is exposed in outputs. Guest release is pinned.",
    "validationBoundary": "Local checks do not replace Azure validate/what-if, actual resource deployment, or on-host guest acceptance.",
    "generatedBy": "scripts/generate_template.py"
  },
  "parameters": {
    "vmName": {
      "type": "string",
      "minLength": 2,
      "maxLength": 48,
      "defaultValue": "[concat('thoxos-', uniqueString(resourceGroup().id, deployment().name))]",
      "metadata": {
        "description": "Name of the new VM. Use 2-48 lowercase letters, digits or hyphens, starting with a letter. Deploy into a NEW dedicated resource group; do not reuse an unrelated VM name. The generated default is scoped to this deployment."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region with quota and capacity for the selected Dsv5 VM size and Ubuntu 24.04 Gen2. The resource-group region is the default."
      }
    },
    "vmSize": {
      "type": "string",
      "defaultValue": "Standard_D2s_v5",
      "allowedValues": [
        "Standard_D2s_v5",
        "Standard_D4s_v5"
      ],
      "metadata": {
        "description": "D2s_v5: 2 vCPU / 8 GiB host RAM. D4s_v5: 4 vCPU / 16 GiB. The ThoxInux TCG guest uses 1 vCPU / 2 GiB. Compute, 128 GiB disk and Standard public IP incur Azure charges; this VM does not shut down automatically."
      }
    },
    "adminUsername": {
      "type": "string",
      "defaultValue": "thoxadmin",
      "minLength": 1,
      "maxLength": 32,
      "allowedValues": [
        "thoxadmin"
      ],
      "metadata": {
        "description": "Linux host administrator. Fixed to thoxadmin to prevent collision with the isolated thoxinux service account. Password authentication is disabled; guest administration uses Azure Run Command with no inbound ports opened."
      }
    },
    "sshPublicKey": {
      "type": "string",
      "minLength": 40,
      "maxLength": 16384,
      "metadata": {
        "description": "Paste your EXISTING OpenSSH PUBLIC key, such as the full contents of id_ed25519.pub or id_rsa.pub. Never paste a private key. This stores the host administration public key; the template opens no SSH port."
      }
    },
    "imageVersion": {
      "type": "string",
      "defaultValue": "latest",
      "minLength": 5,
      "maxLength": 80,
      "metadata": {
        "description": "Ubuntu host marketplace image version, or latest for the current regional Ubuntu 24.04 Gen2 image. The resolved imageReference is output for recording. Use an explicit numeric version for reproducible host builds. The guest remains pinned to ThoxInux v0.9.1 regardless."
      }
    }
  },
  "variables": {
    "nsgName": "[concat(parameters('vmName'), '-nsg')]",
    "egressIpName": "[concat(parameters('vmName'), '-egress')]",
    "vnetName": "[concat(parameters('vmName'), '-vnet')]",
    "nicName": "[concat(parameters('vmName'), '-nic')]",
    "resourceTags": {
      "thox-project": "thoxinux",
      "thox-deployment": "[parameters('vmName')]",
      "thox-release": "v0.9.1",
      "thox-package": "v0.1.0",
      "purpose": "open-source-release-test"
    },
    "bootstrapBase64": ""
  },
  "resources": [
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2024-05-01",
      "name": "[variables('nsgName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('resourceTags')]",
      "properties": {
        "securityRules": [
          {
            "name": "ThoxDenyAllInbound",
            "properties": {
              "priority": 4096,
              "direction": "Inbound",
              "access": "Deny",
              "protocol": "*",
              "sourcePortRange": "*",
              "destinationPortRange": "*",
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "*"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2024-05-01",
      "name": "[variables('egressIpName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('resourceTags')]",
      "sku": {
        "name": "Standard",
        "tier": "Regional"
      },
      "properties": {
        "publicIPAllocationMethod": "Static",
        "publicIPAddressVersion": "IPv4"
      }
    },
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2024-05-01",
      "name": "[variables('vnetName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('resourceTags')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "10.93.0.0/16"
          ]
        },
        "subnets": [
          {
            "name": "host",
            "properties": {
              "addressPrefix": "10.93.1.0/24",
              "defaultOutboundAccess": false
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2024-05-01",
      "name": "[variables('nicName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('resourceTags')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgName'))]",
        "[resourceId('Microsoft.Network/publicIPAddresses', variables('egressIpName'))]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
      ],
      "properties": {
        "enableAcceleratedNetworking": true,
        "enableIPForwarding": false,
        "networkSecurityGroup": {
          "id": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgName'))]"
        },
        "ipConfigurations": [
          {
            "name": "primary",
            "properties": {
              "primary": true,
              "privateIPAllocationMethod": "Dynamic",
              "privateIPAddressVersion": "IPv4",
              "subnet": {
                "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('vnetName'), 'host')]"
              },
              "publicIPAddress": {
                "id": "[resourceId('Microsoft.Network/publicIPAddresses', variables('egressIpName'))]"
              }
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2024-11-01",
      "name": "[parameters('vmName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('resourceTags')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', variables('nicName'))]"
      ],
      "properties": {
        "hardwareProfile": {
          "vmSize": "[parameters('vmSize')]"
        },
        "securityProfile": {
          "securityType": "TrustedLaunch",
          "uefiSettings": {
            "secureBootEnabled": true,
            "vTpmEnabled": true
          }
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "Canonical",
            "offer": "ubuntu-24_04-lts",
            "sku": "server",
            "version": "[parameters('imageVersion')]"
          },
          "osDisk": {
            "name": "[concat(parameters('vmName'), '-os')]",
            "createOption": "FromImage",
            "diskSizeGB": 128,
            "caching": "ReadWrite",
            "deleteOption": "Detach",
            "managedDisk": {
              "storageAccountType": "StandardSSD_LRS"
            }
          }
        },
        "osProfile": {
          "computerName": "[parameters('vmName')]",
          "adminUsername": "[parameters('adminUsername')]",
          "customData": "[variables('bootstrapBase64')]",
          "allowExtensionOperations": true,
          "linuxConfiguration": {
            "disablePasswordAuthentication": true,
            "provisionVMAgent": true,
            "ssh": {
              "publicKeys": [
                {
                  "path": "[format('/home/{0}/.ssh/authorized_keys', parameters('adminUsername'))]",
                  "keyData": "[parameters('sshPublicKey')]"
                }
              ]
            }
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('nicName'))]",
              "properties": {
                "primary": true,
                "deleteOption": "Detach"
              }
            }
          ]
        },
        "diagnosticsProfile": {
          "bootDiagnostics": {
            "enabled": true
          }
        }
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines/runCommands",
      "apiVersion": "2024-11-01",
      "name": "[format('{0}/verify-thoxinux-release', parameters('vmName'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('resourceTags')]",
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachines', parameters('vmName'))]"
      ],
      "properties": {
        "asyncExecution": false,
        "timeoutInSeconds": 1800,
        "treatFailureAsDeploymentFailure": true,
        "source": {
          "script": "#!/usr/bin/env bash\nset -euo pipefail\n# Runs independently of cloud-init, after the Azure VM agent is available.\n# A nonzero cloud-init result or guest readiness result fails ARM deployment.\ntimeout 1500 cloud-init status --wait --long\ntest -x /usr/local/sbin/thoxos-release-status\numask 077\n# Root writes only in a root-owned directory, never a guest-writable log path.\ntest ! -L /var/lib/thoxinux-azure\ninstall -d -o root -g root -m 0700 /var/lib/thoxinux-azure\nreceipt=$(mktemp /var/lib/thoxinux-azure/readiness.XXXXXXXX.json)\nstatus_exit=0\n/usr/local/sbin/thoxos-release-status >\"$receipt\" || status_exit=$?\ncp -- \"$receipt\" /var/lib/thoxinux-azure/azure-readiness.json\npython3 - \"$status_exit\" \"$receipt\" <<'PY'\nimport json,sys\n\ndef rejection_reasons(receipt, status_exit):\n    failures=[]\n    if not isinstance(receipt,dict):\n        return ['Guest status is not a JSON object']\n    if status_exit!=0:\n        failures.append('Guest status command did not exit zero')\n    expected={\n      'marker':'THOXOS_RELEASE_STATUS_V1',\n      'release':'v0.9.1',\n      'source_commit':'84b4a7e740496297ca79dff735834ca2a8f2bad3',\n      'efi_sha256':'1bc1c7af33470edc009fa5756d3fe6063573660e07e157d19397afc680a7bb89',\n      'service_state':'active',\n      'qmp_status':'running',\n    }\n    for key,value in expected.items():\n        if receipt.get(key)!=value:\n            failures.append('Unexpected '+key)\n    for key in ('ok','checksums_verified'):\n        if receipt.get(key) is not True:\n            failures.append(key+' is not true')\n    markers=receipt.get('serial_markers')\n    if not isinstance(markers,dict):\n        failures.append('Serial marker evidence is missing')\n    else:\n        for key in ('unified_identity','controller','prompt'):\n            if markers.get(key) is not True:\n                failures.append('Missing serial marker: '+key)\n        if markers.get('panic') is not False:\n            failures.append('Serial panic check did not pass')\n    smoke=receipt.get('smoke')\n    if not isinstance(smoke,dict):\n        failures.append('Current-boot smoke evidence is missing')\n    else:\n        for key in ('ok','current_boot'):\n            if smoke.get(key) is not True:\n                failures.append('Smoke '+key+' is not true')\n        if smoke.get('commands')!=['status','components','domain list','help']:\n            failures.append('Expected smoke command list is missing')\n    if not isinstance(receipt.get('boot_id'),str) or not receipt['boot_id']:\n        failures.append('Boot identity is missing')\n    if receipt.get('errors')!=[]:\n        failures.append('Status contains errors or an invalid error inventory')\n    return failures\n\nif __name__=='__main__':\n    with open(sys.argv[2],encoding='utf-8') as stream:\n        receipt=json.load(stream)\n    reasons=rejection_reasons(receipt,int(sys.argv[1]))\n    print(json.dumps({'azure_guest_acceptance':'passed' if not reasons else 'failed',\n                      'reasons':reasons,'receipt_path':sys.argv[2],'guest_status':receipt},indent=2))\n    raise SystemExit(1 if reasons else 0)\nPY\n"
        }
      }
    }
  ],
  "outputs": {
    "vmResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Compute/virtualMachines', parameters('vmName'))]"
    },
    "vmName": {
      "type": "string",
      "value": "[parameters('vmName')]"
    },
    "resourceGroup": {
      "type": "string",
      "value": "[resourceGroup().name]"
    },
    "location": {
      "type": "string",
      "value": "[parameters('location')]"
    },
    "hostImageReference": {
      "type": "object",
      "value": "[reference(resourceId('Microsoft.Compute/virtualMachines', parameters('vmName')), '2024-11-01').storageProfile.imageReference]"
    },
    "release": {
      "type": "string",
      "value": "v0.9.1"
    },
    "expectedEfiSha256": {
      "type": "string",
      "value": "1bc1c7af33470edc009fa5756d3fe6063573660e07e157d19397afc680a7bb89"
    },
    "consoleAccess": {
      "type": "string",
      "value": "Azure Run Command. Inbound network connections are denied. Guest console and QMP use local UNIX sockets."
    },
    "verifyCommand": {
      "type": "string",
      "value": "[format('az vm run-command invoke --subscription \"{0}\" --resource-group \"{1}\" --name \"{2}\" --command-id RunShellScript --scripts /usr/local/sbin/thoxos-release-status', subscription().subscriptionId, resourceGroup().name, parameters('vmName'))]"
    },
    "acceptanceResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Compute/virtualMachines/runCommands', parameters('vmName'), 'verify-thoxinux-release')]"
    },
    "acceptanceScope": {
      "type": "string",
      "value": "Managed Run Command gates provisioning on the released EFI hash, active guest, live QMP status, actual serial identity and four current-boot controller checks. Inspect execution state and run fresh status after later changes."
    }
  }
}
